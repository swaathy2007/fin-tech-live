# Application Settings
PROJECT_NAME="FinSight AI Trading API"
VERSION="1.0.0"

# Secret Key for JWT Token Encoding
SECRET_KEY="replace_with_your_secure_random_jwt_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in production, SQLite fallback for local dev)
# Local Postgres example: postgresql+asyncpg://postgres:postgres@localhost:5432/finsight_db
DATABASE_URL="sqlite+aiosqlite:///./finsight.db"

# Redis Configuration (Optional for WebSocket Pub/Sub)
# REDIS_URL="redis://localhost:6379/0"

# Anthropic Claude API Key for AI Copilot Chatbot
# ANTHROPIC_API_KEY="sk-ant-api03-..."
